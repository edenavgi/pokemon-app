# Local development only. Copy to server/.env (gitignored) and fill in.
# On monday code these come from `mapps code:env` (env) and `mapps code:secret` (secrets).

# env
MONDAY_CLIENT_ID=
SERVER_BASE_URL=https://<your tunnel>.apps-tunnel.monday.app
TELEGRAM_BOT_USERNAME=

# secrets
MONDAY_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# provided by monday code in the cloud; set by hand locally
PORT=8080
MNDY_MONGODB_CONNECTION_STRING=mongodb://localhost:27017/pokemon
MNDY_SERVER_ADDRESS=http://localhost:8080

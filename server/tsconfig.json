{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    // "bundler", not "nodenext": the shared code in ../src imports without file extensions,
    // and esbuild (bundle) and tsx (dev) both resolve it the bundler way.
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@app/*": ["../src/*"] }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts",
    "../src/game",
    "../src/api/GameApi.ts",
    "../src/api/boards",
    "../src/api/pokeapi",
    "../src/api/mock/fixtures.ts",
    "../src/lib/messages.ts"
  ],
  "exclude": ["../src/**/*.test.ts", "../src/game/testUtils.ts"]
}

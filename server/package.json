{
  "name": "pokemon-gym-manager-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "bundle": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run bundle"
  },
  "dependencies": {
    "@mondaycom/apps-sdk": "3.3.2",
    "@mondaydotcomorg/api": "^14.3.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
